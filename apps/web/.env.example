# Neon or PostgreSQL connection string. Required outside local development.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/english4free"

# Google sign-in is disabled until all three Auth.js variables are configured.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Email sign-in (one-time links) through Resend. Off until both are set.
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM="English 4 Free <no-reply@your-domain.example>"
# Local development and E2E only: write sign-in links to apps/web/.local-mail/ instead of
# sending them. Works only with a local english4free* database.
# E4F_MAIL_OUTBOX=true

# Data retention (pnpm maintenance:retention). The privacy page shows these numbers.
RECORDING_RETENTION_DAYS="180"
GUEST_RETENTION_DAYS="365"
EMPTY_GUEST_RETENTION_DAYS="30"
TELEMETRY_RETENTION_DAYS="90"

# Optional Phase 3b speech service. The web app remains usable when omitted.
SPEECH_SERVICE_URL="http://localhost:8001"
SPEECH_SERVICE_API_KEY=
SPEECH_SERVICE_TIMEOUT_MS="12000"

# Gemini AI foundation. This API key is read by server-side route handlers only;
# never use a NEXT_PUBLIC_ name or expose it in browser code.
GEMINI_API_KEY=
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_TRANSCRIBE_MODEL="gemini-3.5-transcribe"
GEMINI_API_BASE_URL="https://generativelanguage.googleapis.com/v1beta"
AI_PROVIDER_TIMEOUT_MS="30000"
# Gemini 3 thinking depth for structured feedback: minimal | low | medium | high.
AI_THINKING_LEVEL="low"
# Limits are counted in PostgreSQL, so they hold across restarts and instances.
# Per learner and per operation, and per client IP (a guest who clears cookies keeps the IP).
AI_RATE_LIMIT_MAX_REQUESTS="10"
AI_RATE_LIMIT_IP_MAX_REQUESTS="30"
AI_RATE_LIMIT_WINDOW_MS="3600000"
# Site-wide provider calls per UTC day (cache hits are free). Keep these below the provider's
# daily quota for GEMINI_MODEL and GEMINI_TRANSCRIBE_MODEL.
AI_DAILY_BUDGET="200"
AI_TRANSCRIPTION_DAILY_BUDGET="200"
# Proxies in front of the app that append to X-Forwarded-For (a load balancer or TLS proxy: 1).
TRUSTED_PROXY_HOPS="1"
AI_CACHE_TTL_SECONDS="900"

# Cloudflare R2 or another S3-compatible object store. Keep the bucket private;
# the web app issues short-lived PUT/GET URLs after authorization.
S3_ENDPOINT=
S3_REGION="auto"
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE="false"
# Optional public domain in front of the bucket, added to the Content-Security-Policy.
S3_PUBLIC_URL=
MEDIA_SIGNED_URL_TTL_SECONDS="900"
MEDIA_MAX_UPLOAD_BYTES="250000000"

# Comma-separated bootstrap admins for the initial CMS. Example: admin@example.com
ADMIN_EMAILS=
# Public origin of the site, read at run time (canonical URLs, sitemap, share images).
APP_URL="http://localhost:3000"
# Older name, still read when APP_URL is not set.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# E2E runs (`pnpm test:e2e`) use their own database so they never reset demo data.
# Defaults to DATABASE_URL with the database name replaced by english4free_e2e.
# E2E_DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/english4free_e2e"
# Reserved for isolated Playwright tests only. Never enable this in a deployed app.
# E4F_USE_IN_MEMORY=true
# One-click demo account on /login; `pnpm demo:start` sets it. It only works with a local
# english4free* database. Never set it in a deployed app.
# E4F_DEMO_SIGN_IN=true
# Test-only local admin header. Never configure in production.
# E4F_E2E_ADMIN_TOKEN=local-e2e-only
